// Déclaration de la structure position
typedef struct {
    int x;
    int y;
} Position;

// Fonction pour déplacer le pion
void deplacerPion(int size, char board[size][size], Position *pos) {
    // Efface l'ancienne position
    board[pos->x][pos->y] = ' ';

    // Déplacement simple : haut-bas
    pos->x++;
    
    // Si on dépasse le haut de la grille, on revient en bas
    if (pos->x <0 ) {
        pos->x = size - 1;
    }

    // Met à jour la grille avec la nouvelle position du fou
    board[pos->x][pos->y] = '+';
}

